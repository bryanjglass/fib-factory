{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["client/src", "shared", "tests", "server/engine", "server/room/controller.ts", "server/questions.ts", "server/bank.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["tests/integration/worker.test.ts"]
}
